# scale continuous fixed-effect predictor for better convergence
df_times_inphase_scaled <- df_times_inphase
df_times_inphase_scaled$IPI <- scale(df_times_inphase_scaled$IPI)
# linear regression (random intercepts and slopes)
model_full <- lmer(data = df_times_inphase_scaled,
Asynchrony ~ IPI*ISI*Feedback
+ (1+IPI|Participant))
# add individual predictions
df_times_inphase <- df_times_inphase %>%
add_predictions(model_full)
# show statistics
summary(model_full)
anova(model_full)
print("(nonsignificant effect of Peak_interval)")
model_full_emtrends <- emtrends(model_full, pairwise~ISI:Feedback,
var="IPI",
infer = c(TRUE, TRUE),
lmer.df = "satterthwaite",
lmerTest.limit = 10000)
test_slopes <- test(model_full_emtrends$emtrends, adjust = "fdr")
test_slopes
print("(slopes are not significantly different from zero after multiple comparisons correction FDR)")
model_full_emtrends$contrasts
print("(slopes are not significantly different from each other after multiple comparisons correction Tukey)")
