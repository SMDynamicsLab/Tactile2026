df_times_inphase_participant <- df_times_inphase %>%
group_by(Participant,Trial,Cond) %>%
summarise(n_taps = n()) %>%
filter(n_taps <= 2)
df_times_inphase <- df_times_inphase %>%
anti_join(df_times_inphase_participant,
by = c("Participant", "Cond", "Trial"))
df_voltages_inphase <- df_voltages_inphase %>%
anti_join(df_times_inphase_participant,
by = c("Participant", "Cond", "Trial"))
# outlier summary
print(paste0('number of initial valid taps: ',nrow(df_times)))
print(paste0('number of valid trials flagged as antiphase: '
,nrow(df_times_outphase)))
print(paste0('number of valid taps after antiphase and random outlier removal: '
,nrow(df_times_inphase)))
# Force profiles from single participant:
participant <- 13
df_voltages_inphase_participant <- df_voltages_inphase %>%
filter(Participant==participant)
df_voltages_inphase_part_median <- df_voltages_inphase_participant %>%
group_by(Participant,Effector,Time) %>%
summarize(Voltage_median = mean(Voltage),
Block = first(Block),
Trial = first(Trial),
Tap = first(Tap))
plot_forceprofile <- df_voltages_inphase_participant %>%
ggplot(aes(x = Time, y = Voltage,
color = Effector,
group = interaction(Participant,Block,Trial,Tap))) +
geom_path(aes(color = Effector), alpha = 0.1) +
geom_path(data=df_voltages_inphase_part_median,
aes(x=Time, y=Voltage_median,
color=Effector),
linewidth=1) +
scale_color_viridis_d(begin=color_begin, end=color_end,
option=color_palette) +
scale_fill_viridis_d(begin=color_begin, end=color_end,
option=color_palette) +
theme_bw(base_size=fsize) +
labs(x="Time (ms)", y="Force (a.u.)")
# Histogram of Interpeak interval:
plot_IPIdist <- df_times_inphase %>%
ggplot(aes(x = IPI,
color = Effector,
fill = Effector)) +
geom_density(alpha = 0.5) +
scale_color_viridis_d(begin=color_begin, end=color_end,
option=color_palette) +
scale_fill_viridis_d(begin=color_begin, end=color_end,
option=color_palette) +
theme_bw(base_size=fsize) +
theme(legend.position = "none") +
labs(x = "Interpeak interval (ms)", y = NULL,
color = NULL, fill = NULL)
plot_force_and_hist <- (plot_forceprofile | plot_IPIdist) +
plot_annotation(tag_levels="A")
plot_force_and_hist
ggsave(here("code","plot_force_and_hist.pdf"), plot=plot_force_and_hist, width=fig_width, height=fig_height)
ggsave(here("code","plot_force_and_hist.png"), plot=plot_force_and_hist, width=fig_width, height=fig_height, bg='white',dpi=150)
# ggsave("plot_force_and_hist.pdf", plot=plot_force_and_hist, width=fig_width, height=fig_height)
# ggsave("plot_force_and_hist.png", plot=plot_force_and_hist, width=fig_width, height=fig_height, bg='white',dpi=150)
# Single trial with asynchronies and force profiles
participant <- 13
block <- 2
cond <- "D1"
trial <- 2
fsize <- 11
fig_width <- 10
fig_height <- 4
df_times_inphase_trial <- df_times_inphase %>%
filter(Participant==participant & Block==block &
Cond==cond & Trial==trial)
df_voltages_inphase_trial <- df_voltages_inphase %>%
filter(Participant==participant & Block==block &
Cond==cond & Trial==trial)
tap_breaks <- seq(1, nrow(df_times_inphase_trial), by = 1)
tap_labels <- ifelse(tap_breaks %% 5 == 0, as.character(tap_breaks), "")
plot_singletrial_asyn <- df_times_inphase_trial %>%
ggplot(aes(x=Tap, y=Asynchrony)) +
geom_point() +
geom_line() +
scale_x_continuous(breaks = tap_breaks,
labels = tap_labels) +
coord_cartesian(xlim=c(1.75,nrow(df_times_inphase_trial))) +
theme_bw(base_size=fsize) +
theme(legend.position = "none",
panel.grid.minor = element_blank()) +
labs(x = "Tap number", y = "Asynchrony (ms)")
plot_singletrial_force <- df_voltages_inphase_trial %>%
ggplot(aes(x=Time, y=Voltage)) +
geom_path() +
facet_grid(~Tap) +
scale_x_continuous(breaks = c(0,60)) +
theme_bw(base_size=fsize) +
theme(strip.text = element_blank(),
strip.background = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank()) +
theme(legend.position = "none") +
labs(x = "Time relative to tap occurrence (ms)", y = "Force (a.u.)")
plot_singletrial <- (plot_singletrial_asyn / plot_singletrial_force) +
plot_annotation(tag_levels="A") +
plot_layout(heights = c(5, 3))
ggsave(here("code","plot_singletrial.pdf"), plot=plot_singletrial, width=fig_width, height=fig_height)
ggsave(here("code","plot_singletrial.png"), plot=plot_singletrial, width=fig_width, height=fig_height, bg='white',dpi=150)
# ggsave("plot_singletrial.pdf", plot=plot_singletrial, width=fig_width, height=fig_height)
# ggsave("plot_singletrial.png", plot=plot_singletrial, width=fig_width, height=fig_height, bg='white',dpi=150)
# Plot main result:
fsize <- 9
msize <- 1
fig_width <- 8
fig_height <- 4
# compute averages for plotting theoretical trends
m_Asynchrony <- df_times_inphase %>%
group_by(ISI, Feedback) %>%
summarise(m_Asynchrony = mean(Asynchrony))
plot_fullmodel <- df_times_inphase %>%
ggplot(aes(x = IPI, y = Asynchrony)) +
geom_point(aes(color = Effector), alpha = 0.2, size=msize) +
guides(color=guide_legend(override.aes = list(alpha = 1))) +
# optional: plot individual predictions
# geom_line(aes(y = pred, group = Subjs), color="darkgray") +
geom_smooth(aes(group = 1), method = "lm", color = "black", linewidth=0.5) +
geom_abline(data = m_Asynchrony, aes(intercept = m_Asynchrony, slope = 0),
linetype = "dashed", color = "black") +
geom_abline(data = m_Asynchrony, aes(intercept = m_Asynchrony, slope = -1),
linetype = "dashed", color = "black") +
facet_grid(Feedback~ISI) +
scale_color_viridis_d(begin=color_begin, end=color_end,
option=color_palette) +
scale_fill_viridis_d(begin=color_begin, end=color_end,
option=color_palette) +
theme_bw(base_size=fsize) +
theme(strip.text = element_text(size=fsize,face = "bold"),
strip.background=element_blank()) +
labs(x="Interpeak interval (ms)", y="Asynchrony (ms)")
plot_fullmodel
ggsave(here("code","plot_full.pdf"), plot=plot_fullmodel, width=fig_width, height=fig_height)
ggsave(here("code","plot_full.png"), plot=plot_fullmodel, width=8, height=4, bg='white',dpi=150)
# ggsave("plot_full.pdf", plot=plot_fullmodel, width=fig_width, height=fig_height)
# ggsave("plot_full.png", plot=plot_fullmodel, width=fig_width, height=fig_height, bg='white',dpi=150)
# scale continuous fixed-effect predictor for better convergence
df_times_inphase_scaled <- df_times_inphase
df_times_inphase_scaled$IPI <- scale(df_times_inphase_scaled$IPI)
# linear regression (random intercepts and slopes)
model_full <- lmer(data = df_times_inphase_scaled,
Asynchrony ~ IPI*ISI*Feedback
+ (1+IPI|Participant))
# add individual predictions
df_times_inphase <- df_times_inphase %>%
add_predictions(model_full)
# show statistics
summary(model_full)
anova(model_full)
print("(nonsignificant effect of Peak_interval)")
model_full_emtrends <- emtrends(model_full, pairwise~ISI:Feedback,
var="IPI",
infer = c(TRUE, TRUE),
lmer.df = "satterthwaite",
lmerTest.limit = 10000)
model_full_emtrends
print("(slopes are not significantly different from each other---WithFdbk.666 slope is negative, though)")
# # check regression assumptions
# # uncommment to show
# plot_checkmodel <- plot(performance::check_model(model_full, panel=FALSE))
