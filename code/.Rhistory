# Calculate summary statistics for plotting
summary_stats <- data %>%
group_by(interval, orientation) %>%
summarise(
mean_rate = mean(firing_rate),
se_rate = sd(firing_rate) / sqrt(n()),
.groups = "drop"
)
# Plot 1: Bar plot with error bars (mean ± SE)
p1 <- ggplot(summary_stats, aes(x = interval, y = mean_rate, fill = orientation)) +
geom_bar(stat = "identity", position = position_dodge(0.9), alpha = 0.8,
width = 0.7) +
geom_errorbar(aes(ymin = mean_rate - se_rate, ymax = mean_rate + se_rate),
position = position_dodge(0.9), width = 0.25, size = 0.8) +
labs(title = "Neuron Firing Rates by Condition",
subtitle = paste("Poisson GAM: R² =", round(summary(gam_model)$dev.expl, 3)),
x = "Interval", y = "Mean Firing Rate (spikes/sec ± SE)",
fill = "Orientation (degrees)") +
scale_fill_manual(values = c("180" = "#E69F00", "270" = "#56B4E9")) +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom",
